# /etc/nginx/sites-available/sevinchim.uz
# HTTPS сертификат: sudo certbot --nginx -d sevinchim.uz -d www.sevinchim.uz

server {
    listen 80;
    listen [::]:80;
    server_name sevinchim.uz www.sevinchim.uz;
    return 301 https://sevinchim.uz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name sevinchim.uz www.sevinchim.uz;

    ssl_certificate     /etc/letsencrypt/live/sevinchim.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sevinchim.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    if ($host = www.sevinchim.uz) { return 301 https://sevinchim.uz$request_uri; }

    # Архив аудиоларни юклаш учун (500 МБ гача)
    client_max_body_size 500m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Аудио оқими: буферсиз, Range сўровлари Node'га етиб боради
    location /api/audio/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_buffering off;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
    }

    location /api/admin/upload {
        proxy_pass http://127.0.0.1:3000;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
