# /etc/systemd/system/sevinchim.service
# sudo systemctl enable --now sevinchim
[Unit]
Description=sevinchim.uz (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/sevinchim-uz
EnvironmentFile=/var/www/sevinchim-uz/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
